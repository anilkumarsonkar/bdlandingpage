{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/oncology", "destination": "/index.html?s=oncology" },
    { "source": "/bmt", "destination": "/index.html?s=bmt" },
    { "source": "/cardiac", "destination": "/index.html?s=cardiac" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
